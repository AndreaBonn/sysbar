<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.AndreaBonn.Sysbar" path="/io/github/AndreaBonn/Sysbar/">

    <key name="app-language" type="s">
      <default>''</default>
      <summary>UI language</summary>
      <description>Language code; empty means follow the system locale.</description>
    </key>

    <key name="clamshell-preferred" type="b">
      <default>false</default>
      <summary>Inhibit lid-switch suspend during keep-awake sessions</summary>
    </key>

    <key name="onboarding-step" type="i">
      <default>0</default>
      <summary>Onboarding resume point</summary>
    </key>

    <key name="features-onboarding-version" type="i">
      <default>0</default>
      <summary>Last feature tour version seen</summary>
    </key>

    <key name="last-update-intro-version" type="i">
      <default>0</default>
      <summary>Last update intro version seen</summary>
    </key>

    <key name="default-duration-minutes" type="i">
      <default>0</default>
      <summary>Keep-awake duration in minutes; 0 = indefinite</summary>
      <description>Allowed: 0, 15, 30, 60, 120, 240, 480.</description>
    </key>

    <key name="battery-limit-percent" type="i">
      <default>10</default>
      <summary>Battery cut-off for keep-awake; 0 = never</summary>
      <description>Allowed: 0, 5, 10, 15, 20.</description>
    </key>

    <key name="hotkey-enabled" type="b">
      <default>true</default>
      <summary>Global hotkey to toggle keep-awake</summary>
    </key>

    <key name="hotkey-shelf-enabled" type="b">
      <default>false</default>
      <summary>Global hotkey to open the shelf</summary>
    </key>

    <key name="hotkey-clipboard-enabled" type="b">
      <default>false</default>
      <summary>Global hotkey to open the clipboard history</summary>
    </key>

    <key name="show-countdown" type="b">
      <default>false</default>
      <summary>Show keep-awake countdown in the tray</summary>
    </key>

    <key name="has-onboarded" type="b">
      <default>false</default>
      <summary>Whether first-run onboarding completed</summary>
    </key>

    <key name="auto-check-updates" type="b">
      <default>true</default>
      <summary>Check GitHub Releases for a newer version</summary>
    </key>

    <key name="app-volumes" type="a{sd}">
      <default>{}</default>
      <summary>Per-application volume; app id to 0.0..2.0</summary>
    </key>

    <key name="auto-quit-enabled" type="b">
      <default>false</default>
      <summary>Quit an app when its last window closes</summary>
    </key>

    <key name="auto-quit-exceptions" type="as">
      <default>['org.gnome.Nautilus']</default>
      <summary>Apps kept alive by auto-quit (app id / WM_CLASS)</summary>
    </key>

    <key name="shelf-enabled" type="b">
      <default>false</default>
      <summary>Floating shelf</summary>
    </key>

    <key name="shelf-shake-to-open" type="b">
      <default>true</default>
      <summary>Open the shelf by shaking the pointer (X11 only)</summary>
    </key>

    <key name="clipboard-enabled" type="b">
      <default>false</default>
      <summary>Clipboard history</summary>
    </key>

    <key name="active-scene" type="s">
      <default>''</default>
      <summary>Currently active scene id; empty means none</summary>
    </key>

    <key name="hotkey-focus-scene-enabled" type="b">
      <default>false</default>
      <summary>Global hotkey to toggle the Focus scene</summary>
    </key>

    <key name="hotkey-palette-enabled" type="b">
      <default>false</default>
      <summary>Global hotkey to open the command palette</summary>
    </key>

    <key name="scene-triggers-enabled" type="b">
      <default>false</default>
      <summary>Let scene triggers change the active scene automatically</summary>
    </key>

    <!-- Legacy boolean tray keys (pre-placement). Kept for one-shot migration into
         the "*-placement" keys below; no longer read by the UI. -->
    <key name="menu-bar-cpu" type="b"><default>false</default><summary>Deprecated: show CPU in tray</summary></key>
    <key name="menu-bar-gpu" type="b"><default>false</default><summary>Deprecated: show GPU in tray</summary></key>
    <key name="menu-bar-memory" type="b"><default>false</default><summary>Deprecated: show memory in tray</summary></key>
    <key name="menu-bar-network" type="b"><default>false</default><summary>Deprecated: show network in tray</summary></key>
    <key name="menu-bar-battery" type="b"><default>false</default><summary>Deprecated: show battery in tray</summary></key>
    <key name="menu-bar-power" type="b"><default>false</default><summary>Deprecated: show power in tray</summary></key>

    <!-- Per-metric placement: 'off', 'bar' (always-visible label) or 'menu' (dropdown). -->
    <key name="menu-bar-cpu-placement" type="s"><default>'off'</default><summary>CPU placement: off, bar or menu</summary></key>
    <key name="menu-bar-gpu-placement" type="s"><default>'off'</default><summary>GPU placement: off, bar or menu</summary></key>
    <key name="menu-bar-memory-placement" type="s"><default>'off'</default><summary>Memory placement: off, bar or menu</summary></key>
    <key name="menu-bar-network-placement" type="s"><default>'off'</default><summary>Network placement: off, bar or menu</summary></key>
    <key name="menu-bar-battery-placement" type="s"><default>'off'</default><summary>Battery placement: off, bar or menu</summary></key>
    <key name="menu-bar-power-placement" type="s"><default>'off'</default><summary>Power placement: off, bar or menu</summary></key>

    <key name="menu-bar-memory-style" type="s">
      <default>'percent'</default>
      <summary>Tray memory representation: dot, percent or both</summary>
    </key>

    <key name="menu-show-device-batteries" type="b">
      <default>false</default>
      <summary>List connected peripheral batteries in the tray menu</summary>
      <description>Keyboard, mouse, headset and other devices reported by UPower.</description>
    </key>

    <key name="monitor-interval-seconds" type="i">
      <default>2</default>
      <summary>Sampling cadence in seconds; allowed 1, 2, 5</summary>
    </key>

    <key name="temperature-unit" type="s">
      <default>'celsius'</default>
      <summary>celsius or fahrenheit</summary>
    </key>

    <key name="monitor-show-system" type="b"><default>true</default><summary>Show System section</summary></key>
    <key name="monitor-show-network" type="b"><default>true</default><summary>Show Network section</summary></key>
    <key name="monitor-show-power" type="b"><default>true</default><summary>Show Power section</summary></key>
    <key name="monitor-show-mixer" type="b"><default>true</default><summary>Show Mixer section</summary></key>
    <key name="monitor-show-fan-control-beta" type="b"><default>false</default><summary>Show Fan Control (beta)</summary></key>

    <key name="panel-navigation-enabled" type="b">
      <default>true</default>
      <summary>Section navigation in the panel</summary>
    </key>
    <key name="panel-section-order" type="s">
      <default>''</default>
      <summary>Section order, comma-separated ids</summary>
    </key>
    <key name="panel-collapsed-sections" type="s">
      <default>''</default>
      <summary>Collapsed sections, comma-separated ids</summary>
    </key>

    <key name="monitor-graph-cpu" type="b"><default>true</default><summary>History graph: CPU</summary></key>
    <key name="monitor-graph-gpu" type="b"><default>true</default><summary>History graph: GPU</summary></key>
    <key name="monitor-graph-memory" type="b"><default>true</default><summary>History graph: memory</summary></key>
    <key name="monitor-graph-network" type="b"><default>true</default><summary>History graph: network</summary></key>
    <key name="monitor-graph-power" type="b"><default>true</default><summary>History graph: power</summary></key>
    <key name="monitor-graph-battery" type="b"><default>true</default><summary>History graph: battery</summary></key>

    <key name="monitor-sys-temps" type="b"><default>true</default><summary>System: temperatures</summary></key>
    <key name="monitor-sys-cpu" type="b"><default>true</default><summary>System: CPU</summary></key>
    <key name="monitor-sys-gpu" type="b"><default>true</default><summary>System: GPU</summary></key>
    <key name="monitor-sys-battery" type="b"><default>true</default><summary>System: battery</summary></key>
    <key name="monitor-sys-memory" type="b"><default>true</default><summary>System: memory</summary></key>
    <key name="monitor-sys-uptime" type="b"><default>true</default><summary>System: uptime</summary></key>

    <key name="monitor-net-speed" type="b"><default>true</default><summary>Network: speed</summary></key>
    <key name="monitor-net-totals" type="b"><default>true</default><summary>Network: totals</summary></key>
    <key name="monitor-net-test" type="b"><default>true</default><summary>Network: speed test</summary></key>

    <key name="monitor-pwr-system" type="b"><default>true</default><summary>Power: system draw</summary></key>
    <key name="monitor-pwr-adapter" type="b"><default>true</default><summary>Power: adapter</summary></key>
    <key name="monitor-pwr-battery" type="b"><default>true</default><summary>Power: battery</summary></key>
    <key name="monitor-pwr-health" type="b"><default>true</default><summary>Power: battery health</summary></key>

    <!-- Threshold alerts: a notification fires when a metric crosses its limit.
         Each percentage uses 0 to mean "off". CPU also requires the breach to
         hold for "alert-cpu-seconds". -->
    <key name="alert-enabled" type="b">
      <default>false</default>
      <summary>Master switch for system-monitor threshold alerts</summary>
    </key>
    <key name="alert-cpu-percent" type="i">
      <default>0</default>
      <summary>Notify when CPU load stays at/above this percent; 0 = off</summary>
    </key>
    <key name="alert-cpu-seconds" type="i">
      <default>30</default>
      <summary>How long CPU must stay above the threshold before alerting</summary>
    </key>
    <key name="alert-memory-percent" type="i">
      <default>0</default>
      <summary>Notify when memory use reaches this percent; 0 = off</summary>
    </key>
    <key name="alert-disk-percent" type="i">
      <default>0</default>
      <summary>Notify when the root filesystem is this percent full; 0 = off</summary>
    </key>
    <key name="alert-temperature-celsius" type="i">
      <default>0</default>
      <summary>Notify when temperature reaches this many °C; 0 = off</summary>
    </key>
    <key name="alert-battery-percent" type="i">
      <default>0</default>
      <summary>Notify when on battery and charge falls to this percent; 0 = off</summary>
    </key>

  </schema>
</schemalist>
