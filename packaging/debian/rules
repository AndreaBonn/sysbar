#!/usr/bin/make -f
# Build a self-contained venv under /opt/sysbar (system-site-packages so it
# reuses the distribution's python3-gi/GTK) plus the data files.
export DH_VERBOSE = 1

PKG = debian/sysbar
VENV = $(PKG)/opt/sysbar

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	python3 -m venv --system-site-packages $(VENV)
	$(VENV)/bin/pip install --no-cache-dir --upgrade pip
	$(VENV)/bin/pip install --no-cache-dir .
	# pip writes console-script shebangs pointing at the staging path; rewrite
	# them to the installed venv interpreter so they run after relocation.
	sed -i '1s|^#!.*|#!/opt/sysbar/bin/python3|' $(VENV)/bin/sysbar
	# Drop the venv's hardcoded build path; the wrapper sets it at runtime.
	find $(VENV) -name '*.pyc' -delete

	install -d $(PKG)/usr/bin
	install -m 0755 packaging/sysbar-wrapper $(PKG)/usr/bin/sysbar

	install -d $(PKG)/usr/share/glib-2.0/schemas
	install -m 0644 data/io.github.AndreaBonn.Sysbar.gschema.xml \
		$(PKG)/usr/share/glib-2.0/schemas/

	install -d $(PKG)/usr/share/applications
	install -m 0644 data/io.github.AndreaBonn.Sysbar.desktop \
		$(PKG)/usr/share/applications/

	# Branded application icon, in every hicolor size present. GNOME maps the
	# desktop "Icon=" to these for the panel/settings window and the taskbar;
	# postinst refreshes the icon cache. Skipped silently if no icons were
	# generated (run scripts/generate-icons.sh from a master image).
	if [ -d data/icons/hicolor ]; then \
		for png in $$(find data/icons/hicolor -name '*.png'); do \
			dest=$(PKG)/usr/share/icons/$${png#data/icons/}; \
			install -d $$(dirname $$dest); \
			install -m 0644 $$png $$dest; \
		done; \
	fi

	# Start at login for every user; disable per-user from the desktop settings.
	install -d $(PKG)/etc/xdg/autostart
	install -m 0644 data/autostart/io.github.AndreaBonn.Sysbar.desktop \
		$(PKG)/etc/xdg/autostart/

	# GNOME Shell extension that powers auto-quit on Wayland. Installed system
	# wide; users enable it per-session (gnome-extensions enable, or the
	# Extensions app). A no-op on X11, where libwnck is used instead.
	install -d $(PKG)/usr/share/gnome-shell/extensions/sysbar-window-manager@andreabonn.github.io
	install -m 0644 data/gnome-extension/metadata.json \
		$(PKG)/usr/share/gnome-shell/extensions/sysbar-window-manager@andreabonn.github.io/
	install -m 0644 data/gnome-extension/extension.js \
		$(PKG)/usr/share/gnome-shell/extensions/sysbar-window-manager@andreabonn.github.io/

	# The destination must exist first: with a single language dir as source,
	# cp into a missing target would rename it (it/ -> locale/), flattening the
	# language level and breaking gettext lookup.
	install -d $(PKG)/usr/share/locale
	if [ -d data/locale ]; then \
		cp -r data/locale/* $(PKG)/usr/share/locale/ 2>/dev/null || true; \
	fi

override_dh_fixperms:
	dh_fixperms
	chmod 0755 $(PKG)/opt/sysbar/bin/* || true
