# Sysbar non richiede secret. La configurazione runtime vive in GSettings.
# Queste variabili servono solo a sviluppo e diagnostica.

# Livello di log: DEBUG | INFO | WARNING | ERROR | CRITICAL
SYSBAR_LOG_LEVEL=INFO

# Formato log: human (sviluppo) | json (produzione)
SYSBAR_LOG_FORMAT=human

# Dir degli schemi GSettings compilati, per eseguire senza installare il .deb.
# Impostata automaticamente da `./build.sh` in sviluppo.
# GSETTINGS_SCHEMA_DIR=./build/schemas
